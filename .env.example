# Copy to .env for local development. Never commit .env to version control.
# For Vercel PostgreSQL, set POSTGRES_URL in the Vercel project dashboard instead.

# Leave blank to use SQLite automatically (tasks.db created in project root)
# DATABASE_URL=sqlite:///tasks.db

# For PostgreSQL (Vercel Postgres, Neon, Supabase, etc.)
# POSTGRES_URL=postgresql://user:password@host:5432/dbname
